# Copy these settings into your hosting provider's environment variables.
# Do not commit real secret keys to GitHub.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
NEXORA_ADMIN_EMAIL=admin@example.com
NEXORA_ADMIN_PASSWORD=replace-with-a-strong-unique-password
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXORA_CURRENCY=USD
COOKIE_SECURE=1
FLASK_DEBUG=0
